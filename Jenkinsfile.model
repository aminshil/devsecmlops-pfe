// DevSecMLOps model pipeline (Jenkins job "devsecmlops-model", run on demand).
//
// This job produces a new model and hands it to the normal pipeline. It never builds an image.
//
//   1  Checkout and preflight   dependencies, datasets, MLflow reachability, memory guard (full)
//   2  Export operator feedback as a versioned dataset   (optional; kubectl exec into PostgreSQL)
//   3  Prepare smoke data       smoke only: tiny generated fleets + a scratch copy of the production artifacts
//   4  Train candidate -> (full + PROMOTE) select the candidate's own threshold on the independent
//      validation fleet -> evaluate candidate AND production on the test set -> guardrail
//   5  Evidence                 report summary; smoke: the real models/ is byte-for-byte untouched
//   6  Verify MLflow + MinIO    full only: the run's six model files are downloaded back from MLflow (MinIO)
//                               and each SHA-256 compared with the one the run recorded
//   7  Activate locally         run the CI model gate on the promoted manifest, then make it this site's
//                               current model in the local model store (no Git push, no Git credential)
//   8  Trigger the application pipeline with MODEL_SOURCE=store: it bakes this site's current model into
//      the image, then gates, builds, scans, deploys and verifies it
//
// SITE (empty = this installation's site, PFE_SITE, which Ansible sets from site_name; "default" when
//   unset): which site's model. Each site keeps its own models on its own machine in
//   the local model store (scripts/model_store.py, under MODEL_STORE in the jenkins_home volume);
//   a site with no model yet starts from the repository's reference model in models/, so its first
//   retraining must beat that model on the site's own test set. Data: fleet-data/ for "default",
//   fleet-data/sites/<site>/ for any other site. MLflow experiment: telecom-<site> (other sites).
//
// SCOPE=smoke (default): tiny fleets, scratch directories, no MLflow logging (keeps the production
//   experiment clean), never commits or deploys. About 5 minutes. Proves the wiring in Jenkins.
// SCOPE=full: the real 17M-row datasets from the data mount, logs to MLflow (artifacts land in MinIO).
//   Needs about 9 GB of free memory: stop SonarQube first. PROMOTE is honoured only here.
//
// A rejected candidate is a valid outcome: the build is marked UNSTABLE, production is untouched and
// nothing is activated. The run report is archived either way.
//
// Prerequisites this job needs (provisioned by Ansible, not by this file):
//   - the Jenkins container has data/ mounted read-only at /var/jenkins_home/fleet-data
//   - the Jenkins container has PFE_SITE, this machine's site name (Ansible site_name)
//   - nothing else: promotion no longer pushes to Git, so no Git credential is needed
pipeline {
    agent any

    parameters {
        choice(name: 'SCOPE', choices: ['smoke', 'full'],
               description: 'smoke: tiny generated fleets, scratch directories, never commits or deploys. full: the full-size datasets, logs to MLflow, needs about 9 GB free memory.')
        booleanParam(name: 'INCLUDE_FEEDBACK', defaultValue: true,
                     description: 'Export operator verdicts from PostgreSQL (kubectl exec) and train on them too')
        string(name: 'SITE', defaultValue: '',
               description: "Which site this model is for (lowercase letters, digits, - and _). Empty: this installation's site (PFE_SITE, set by Ansible), or 'default' if it has none. Its model lives in the local model store.")
        booleanParam(name: 'PROMOTE', defaultValue: false,
                     description: "full scope only: select the candidate threshold on the validation fleet, then activate it in this site's local model store and deploy it if the guardrail passes")
    }

    environment {
        DATA          = "/var/jenkins_home/fleet-data"      // read-only mount of repo data/
        KUBECONFIG    = "/home/pfe/.kube/config"
        // Tracking server: the mlflow container on devsecmlops-net, reached by name (Jenkins is attached to
        // that network); artifacts are proxied by the server into MinIO, so no storage credentials are needed here.
        MLFLOW_TRACKING_URI = "http://mlflow:5001"
        MIN_F1        = "0.60"          // minimum served v4 F1 the CI model gate accepts
        MODEL_STORE   = "/var/jenkins_home/model-store"   // each site's promoted models (scripts/model_store.py)
    }

    options {
        timeout(time: 3, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('1. Checkout and preflight') {
            steps {
                checkout scm
                sh '''
                    git log --oneline -1
                    rm -rf build
                    python3 -m pip install --quiet --break-system-packages -r requirements-api.txt mlflow==3.17.2
                '''
                script {
                    env.DO_PROMOTE = (params.SCOPE == 'full' && params.PROMOTE) ? 'true' : 'false'
                    // empty SITE (or null, on the first run after the parameter was added): the site this
                    // Jenkins belongs to (container variable PFE_SITE, Ansible site_name), else 'default'
                    def site = params.SITE?.trim() ?: (env.PFE_SITE?.trim() ?: 'default')
                    if (!(site ==~ /[a-z0-9][a-z0-9_-]{0,31}/)) {
                        error("invalid SITE '${site}': lowercase letters, digits, - and _ only")
                    }
                    env.SITE_NAME = site
                    env.SITE_DATA = site == 'default' ? env.DATA : "${env.DATA}/sites/${site}"
                    if (site != 'default') {
                        env.MLFLOW_EXPERIMENT_NAME = "telecom-${site}"
                    }
                    echo "site ${site}: data ${env.SITE_DATA}, model store ${env.MODEL_STORE}/${site}"
                    if (params.PROMOTE && params.SCOPE != 'full') {
                        echo 'PROMOTE is ignored in smoke scope: nothing is committed or deployed'
                    }
                    def mlflowOk = sh(returnStatus: true,
                                      script: 'curl -sf --max-time 10 ${MLFLOW_TRACKING_URI}/health') == 0
                    if (mlflowOk) {
                        echo 'MLflow reachable'
                    } else if (params.SCOPE == 'full') {
                        error("MLflow is not reachable at ${env.MLFLOW_TRACKING_URI}")
                    } else {
                        echo 'WARNING: MLflow is not reachable (not needed in smoke scope)'
                    }
                    if (params.SCOPE == 'full') {
                        sh '''
                            test -f ${SITE_DATA}/telecom_fleet_v2_labeled.csv
                            test -f ${SITE_DATA}/telecom_fleet_v2_test.csv
                            test -f ${SITE_DATA}/telecom_fleet_v2_val.csv
                            # this site's production model: created from the reference model the first time,
                            # then copied into build/staging, the folder the guardrail compares against
                            python3 scripts/model_store.py init  --site "${SITE_NAME}" --from models
                            python3 scripts/model_store.py stage --site "${SITE_NAME}" --to build/staging
                            avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
                            echo "memory available: ${avail} MiB"
                            if [ "$avail" -lt 9000 ]; then
                                echo "the full scope needs about 9000 MiB free: stop SonarQube (docker stop sonarqube) and retry"
                                exit 1
                            fi
                        '''
                    } else {
                        sh 'test -f ml-model/generate_telecom_fleet.py'
                    }
                }
            }
        }

        stage('2. Export feedback dataset') {
            when { expression { params.INCLUDE_FEEDBACK } }
            steps {
                sh 'python3 scripts/export_feedback_dataset.py --out-dir build/feedback'
            }
        }

        stage('3. Prepare smoke data') {
            when { expression { params.SCOPE == 'smoke' } }
            steps {
                sh '''
                    mkdir -p build/smoke-data build/smoke-models
                    python3 ml-model/generate_telecom_fleet.py --machines 30 --days 3 --seed 42  --anomaly-ratio 0.08 --output build/smoke-data/train.csv > build/smoke-data/gen-train.log
                    python3 ml-model/generate_telecom_fleet.py --machines 30 --days 3 --seed 123 --anomaly-ratio 0.08 --output build/smoke-data/test.csv  > build/smoke-data/gen-test.log
                    cp models/telecom_xgb_classifier_v2.pkl models/telecom_xgb_label_encoder_v2.pkl \
                       models/telecom_xgb_v4_rolling.pkl models/telecom_xgb_v4_rolling_encoder.pkl \
                       models/telecom_iso_v2.pkl models/telecom_baselines_v2.json models/manifest.json \
                       build/smoke-models/
                    sha256sum models/*.pkl models/*.json > build/production-before.sha256
                    tail -n 3 build/smoke-data/gen-train.log
                '''
            }
        }

        stage('4. Train, evaluate, guardrail') {
            steps {
                script {
                    def fb = sh(script: 'ls build/feedback/*.csv 2>/dev/null | tr "\\n" " "',
                                returnStdout: true).trim()
                    def feedbackArg = fb ? '--feedback ' + fb : ''
                    def cmd
                    if (params.SCOPE == 'smoke') {
                        cmd = "env -u MLFLOW_TRACKING_URI python3 ml-model/train_production.py " +
                              "--train build/smoke-data/train.csv --test build/smoke-data/test.csv " +
                              "--normal-sample 5000 --models-dir build/smoke-models --work-dir build/smoke-work " +
                              "${feedbackArg} --report build/model-report.json"
                    } else {
                        def promoteArgs = env.DO_PROMOTE == 'true' ? "--promote --val ${env.SITE_DATA}/telecom_fleet_v2_val.csv" : ''
                        cmd = "python3 ml-model/train_production.py --models-dir build/staging " +
                              "--train ${env.SITE_DATA}/telecom_fleet_v2_labeled.csv --test ${env.SITE_DATA}/telecom_fleet_v2_test.csv " +
                              "${feedbackArg} ${promoteArgs} --report build/model-report.json"
                    }
                    def rc = sh(returnStatus: true, script: cmd)
                    if (rc == 3) {        // train_production.py EXIT_REJECTED; a crash exits 1
                        env.MODEL_OUTCOME = 'rejected'
                        unstable('Guardrail rejected the candidate -- production model unchanged')
                    } else if (rc != 0) {
                        error("training pipeline failed (exit ${rc})")
                    } else {
                        env.MODEL_OUTCOME = env.DO_PROMOTE == 'true' ? 'promoted' : 'passed'
                    }
                }
            }
        }

        stage('5. Evidence') {
            steps {
                sh 'python3 scripts/model_report_summary.py build/model-report.json'
                script {
                    if (params.SCOPE == 'smoke') {
                        sh '''
                            sha256sum -c build/production-before.sha256
                            test -z "$(git status --porcelain models/)"
                            echo "the real models/ directory is untouched (hashes identical, git status clean)"
                        '''
                    }
                }
            }
        }

        stage('6. Verify MLflow and MinIO') {
            when { expression { params.SCOPE == 'full' } }
            steps {
                sh '''
                    # Download the candidate's six files back from MLflow (stored in MinIO) and
                    # compare each SHA-256 with the hashes the run recorded: proof the store holds
                    # exactly the files that were evaluated, not just six names.
                    python3 scripts/verify_mlflow_artifacts.py --report build/model-report.json \
                        --tracking-uri "${MLFLOW_TRACKING_URI}"
                '''
            }
        }

        stage('7. Activate in the local model store') {
            when { expression { env.MODEL_OUTCOME == 'promoted' } }
            steps {
                // No Git push and no Git credential: the promoted model stays on this site. The CI
                // model gate checks it first; then the store keeps the previous model as a version
                // (rollback: scripts/model_store.py rollback) and the candidate becomes current.
                sh '''
                    python3 scripts/verify_model_manifest.py --manifest build/staging/manifest.json --min-f1 ${MIN_F1} || { echo "CI model gate refused the promoted model (see above)"; exit 1; }
                    python3 scripts/model_store.py activate --site "${SITE_NAME}" --from build/staging --build "${BUILD_NUMBER}"
                    python3 scripts/model_store.py status --site "${SITE_NAME}"
                '''
            }
        }

        stage('8. Deploy through the application pipeline') {
            when { expression { env.MODEL_OUTCOME == 'promoted' } }
            steps {
                // The application pipeline bakes this site's current model (from the store) into the image.
                build job: 'devsecmlops-pipeline', wait: true,
                      parameters: [string(name: 'MODEL_SOURCE', value: 'store'), string(name: 'SITE', value: env.SITE_NAME)]
            }
        }
    }

    post {
        // the feedback export itself (raw metrics, operator notes) is not archived: only its fingerprint;
        // its row counts are in the report
        always   { archiveArtifacts artifacts: 'build/model-report.json,build/feedback/*.sha256', allowEmptyArchive: true }
        success  { echo "Model pipeline (${params.SCOPE}): ${env.MODEL_OUTCOME}" }
        unstable { echo "Model pipeline (${params.SCOPE}): candidate rejected by the guardrail; production unchanged" }
        failure  { echo "Model pipeline FAILED at ${env.STAGE_NAME}" }
    }
}
