# Alertmanager configuration TEMPLATE. scripts/setup_alerting.sh writes the real file to
# /etc/devsecmlops/alertmanager/alertmanager.yml, replacing __TELEGRAM_CHAT_ID__; the bot token is
# read from a root-only file (bot_token_file) and never appears in the repository or in this file.
global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/telegram.tmpl

route:
  receiver: telegram
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # one running list of every anomalous machine, sent within 5 s of every change: a machine turns
    # anomalous (AnomalyDetected, marked new), a machine clears (AnomalyCleared, "back to normal"), or
    # no machine reports any more (FleetNoData, "no information"). The receiver ignores resolved alerts
    # (send_resolved: false), so Prometheus re-sending them for 15 minutes cannot trigger a message.
    - matchers: ['alertname=~"AnomalyDetected|AnomalyCleared|FleetNoData"']
      receiver: telegram-anomalies
      group_by: [severity]
      group_wait: 1s
      group_interval: 5s
      repeat_interval: 6h
    # something is down: one message per failing layer or target, sent at once
    - matchers: ['severity="critical"']
      receiver: telegram
      group_by: ['...']
      group_wait: 1s
      group_interval: 30s
      repeat_interval: 2h

inhibit_rules:
  # with the Kubernetes API down, the per-pod alerts are consequences, not causes
  - source_matchers: ['alertname="KubernetesUnreachable"']
    target_matchers: ['alertname=~"ServingPodNotScraped|PodNotReady|ServingReplicasMissing|PredictionsStopped"']

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram_token
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: HTML
        message: '{{ template "devsecmlops.telegram" . }}'
        send_resolved: true
  - name: telegram-anomalies
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram_token
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: HTML
        message: '{{ template "devsecmlops.anomalies" . }}'
        send_resolved: false
