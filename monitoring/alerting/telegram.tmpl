{{/* Telegram message for one group of alerts (at most 15 listed; Telegram caps a message at 4096 characters). */}}
{{ define "devsecmlops.telegram" -}}
{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b> · {{ .Status }} · {{ len .Alerts }} alert(s){{ if .CommonLabels.severity }} · {{ .CommonLabels.severity }}{{ end }}
{{ range $i, $a := .Alerts }}{{ if lt $i 15 }}• {{ if eq $.Status "resolved" }}cleared: {{ end }}{{ $a.Annotations.summary }}
{{ end }}{{ end }}{{ if gt (len .Alerts) 15 }}… showing 15 of {{ len .Alerts }}
{{ end }}{{ if eq .Status "firing" }}{{ with .CommonAnnotations.description }}<i>{{ . }}</i>{{ end }}{{ end }}
DevSecMLOps · Alertmanager :9093
{{- end }}

{{/* Machine anomalies as ONE running list, re-sent whenever it changes: every machine anomalous now,
     alphabetical, with how long each has been anomalous; 🆕 + marks a machine that turned anomalous in
     the last minute; the machines that just cleared follow. At most 60 + 15 lines, so the message stays
     under Telegram's 4096-character limit even in a fleet-wide incident. Needs Alertmanager >= 0.28. */}}
{{ define "devsecmlops.anomalies" -}}
{{- /* counts are kept as strings of "x" (Alertmanager templates have no arithmetic) */ -}}
{{- $nodata := false }}{{ $n := "" }}{{ range .Alerts.Firing }}{{ if eq .Labels.alertname "FleetNoData" }}{{ $nodata = true }}{{ end }}{{ if eq .Labels.alertname "AnomalyDetected" }}{{ $n = print $n "x" }}{{ end }}{{ end -}}
{{ if $nodata }}⚪ <b>Anomalies</b> · no information: no machine has reported in the last 5 minutes
{{ else if $n }}📋 <b>Anomalies</b> · {{ len $n }} machine(s) anomalous now
{{ else }}✅ <b>Anomalies</b> · all clear
{{ end -}}
{{ $shown := "" }}{{ range .Alerts.Firing }}{{ if and (eq .Labels.alertname "AnomalyDetected") (lt (len $shown) 60) }}{{ $shown = print $shown "x" }}{{ if lt (since .StartsAt).Seconds 60.0 }}🆕 <b>+ {{ .Labels.machine }}</b> ({{ .Labels.machine_type }}) · new
{{ else }}• {{ .Labels.machine }} ({{ .Labels.machine_type }}) · {{ humanizeDuration (since .StartsAt).Seconds }}
{{ end }}{{ end }}{{ end -}}
{{ if gt (len $n) 60 }}… 60 of {{ len $n }} listed
{{ end -}}
{{ $c := "" }}{{ range .Alerts.Firing }}{{ if and (eq .Labels.alertname "AnomalyCleared") (lt (since .StartsAt).Seconds 20.0) }}{{ if lt (len $c) 15 }}✅ − {{ .Labels.machine }} ({{ .Labels.machine_type }}) back to normal
{{ end }}{{ $c = print $c "x" }}{{ end }}{{ end -}}
{{ if gt (len $c) 15 }}… 15 of {{ len $c }} back to normal listed
{{ end }}DevSecMLOps · Alertmanager :9093
{{- end }}
