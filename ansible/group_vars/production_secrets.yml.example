# Template for the Vault-encrypted production secrets. This .example file is NOT loaded.
# Easiest: run  scripts/make_production_secrets.sh  (generates a random password and encrypts it).
# By hand:  cp production_secrets.yml.example production_secrets.yml
#           ansible-vault encrypt production_secrets.yml
vault_db_password: "CHANGE-ME-use-a-long-random-value"
